{
  "name": "sloppy-pdf-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "NO_STRIP=true tauri build",
    "copy-pdfjs": "mkdir -p src/pdfjs && cp node_modules/pdfjs-dist/build/pdf.min.mjs node_modules/pdfjs-dist/build/pdf.worker.min.mjs node_modules/pdfjs-dist/web/pdf_viewer.mjs node_modules/pdfjs-dist/web/pdf_viewer.css src/pdfjs/",
    "test": "npx playwright test",
    "test:gen-fixtures": "node tests/generate-fixtures.js"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tauri-apps/cli": "^2",
    "http-server": "^14.1.1",
    "pdf-lib": "^1.17.1"
  }
}
